<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.title }} | MaxServ</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<main class="product-detail">

    <a href="/" class="back-link">
        ← Terug naar catalogue
    </a>

    <section class="product-detail-layout">

        <div class="product-detail-image-wrapper">

            {% if product.thumbnail %}
                <img
                    class="product-detail-image"
                    src="{{ product.thumbnail }}"
                    alt="{{ product.title }}"
                >
            {% else %}
                <div class="product-detail-image-placeholder">
                    Geen afbeelding beschikbaar
                </div>
            {% endif %}

        </div>

        <div class="product-detail-content">

            <span class="product-category">
                {{ product.category }}
            </span>

            <h1>{{ product.title }}</h1>

            <p class="product-detail-brand">
                {{ product.brand ?? 'Onbekend merk' }}
            </p>

            <div class="product-detail-price">

                <span class="product-detail-original-price">
                    €{{ product.price|number_format(2, ',', '.') }}
                </span>

                {% if product.discount_percentage > 0 %}
                    <span class="discount-badge">
                        -{{ product.discount_percentage|number_format(2, ',', '.') }}%
                    </span>
                {% endif %}

                <strong>
                    €{{ product.discount_price|number_format(2, ',', '.') }}
                </strong>

            </div>

            <div class="product-stock">
                <span class="stock-dot"></span>
                Voorraad: {{ product.stock }}
            </div>

            <div class="product-description">
                <h2>Over dit product</h2>

                <p>
                    {{ product.description }}
                </p>
            </div>

            <div class="product-meta">

                <div>
                    <span>Merk</span>
                    <strong>{{ product.brand ?? 'Onbekend' }}</strong>
                </div>

                <div>
                    <span>Categorie</span>
                    <strong>{{ product.category }}</strong>
                </div>

                {% if product.sku %}
                    <div>
                        <span>SKU</span>
                        <strong>{{ product.sku }}</strong>
                    </div>
                {% endif %}

                {% if product.rating %}
                    <div>
                        <span>Rating</span>
                        <strong>{{ product.rating|number_format(2, ',', '.') }} / 5</strong>
                    </div>
                {% endif %}

            </div>

        </div>

    </section>

</main>

</body>
</html>
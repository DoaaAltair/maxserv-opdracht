<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Producten | MaxServ</title>
</head>
<body>
    <main>
        <h1>Producten</h1>

        {% if products is empty %}
            <p>Er zijn nog geen producten geïmporteerd.</p>
        {% else %}
            <p>{{ products|length }} producten gevonden.</p>

            <ul>
                {% for product in products %}
                    <li>
                        <strong>{{ product.title }}</strong>
                        — €{{ product.price|number_format(2, ',', '.') }}
                        — {{ product.brand ?? 'Onbekend merk' }}
                        — {{ product.category }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
</body>
</html>
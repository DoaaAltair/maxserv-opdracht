<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MaxServ Products</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <div>
            <p>MAXSERV ASSIGNMENT</p>
            <h1>Product catalogus</h1>
            <p>{{ products|length }} producten uit onze database</p>
        </div>
    </header>

    <main>
        {% if products is empty %}
            <p>Er zijn nog geen producten geïmporteerd.</p>
        {% else %}
            <section>
                {% for product in products %}
                    <article>
                        {% if product.thumbnail %}
                            <img
                                src="{{ product.thumbnail }}"
                                alt="{{ product.title }}"
                                width="200"
                            >
                        {% endif %}

                        <div>
                            <span>{{ product.category }}</span>

                            <h2>{{ product.title }}</h2>

                            <p>{{ product.brand ?? 'Onbekend merk' }}</p>

                            <div>
                                <span>
                                    €{{ product.price|number_format(2, ',', '.') }}
                                </span>

                                <span>
                                    {{ product.discount_percentage|number_format(2, ',', '.') }}% korting
                                </span>

                                <strong>
                                    €{{ product.discount_price|number_format(2, ',', '.') }}
                                </strong>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </section>
        {% endif %}
    </main>
</body>
</html>
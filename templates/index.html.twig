<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MaxServ Products</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <div>
            <p>MAXSERV ASSIGNMENT</p>
            <h1>Product catalogus</h1>
            <p>{{ products|length }} producten uit onze database</p>
        </div>
    </header>

    <main>

        <form method="get" class="filters">
            <label for="category">Categorie</label>

            <select name="category" id="category" onchange="this.form.submit()">
                <option value="">Alle categorieën</option>

                {% for item in categories %}
                    <option value="{{ item }}" {% if category == item %}selected{% endif %}>
                        {{ item|capitalize }}
                    </option>
                {% endfor %}
            </select>

            <label for="brand">Merk</label>

            <select name="brand" id="brand">
                <option value="">Alle merken</option>

                {% for item in brands %}
                    <option value="{{ item }}" {% if brand == item %}selected{% endif %}>
                        {{ item }}
                    </option>
                {% endfor %}
            </select>

            <label for="sort">Sorteren</label>

            <select name="sort" id="sort">
                <option value="title" {% if sort == 'title' %}selected{% endif %}>
                    Naam
                </option>
                <option value="price" {% if sort == 'price' %}selected{% endif %}>
                    Prijs
                </option>
                <option value="brand" {% if sort == 'brand' %}selected{% endif %}>
                    Merk
                </option>
                <option value="category" {% if sort == 'category' %}selected{% endif %}>
                    Categorie
                </option>
                <option value="discount_percentage" {% if sort == 'discount_percentage' %}selected{% endif %}>
                    Korting
                </option>
            </select>

            <select name="direction" id="direction">
                <option value="asc" {% if direction == 'asc' %}selected{% endif %}>
                    Oplopend
                </option>

                <option value="desc" {% if direction == 'desc' %}selected{% endif %}>
                    Aflopend
                </option>
            </select>
            <button type="submit">Filter</button>
        </form>

        {% if products is empty %}
            <p>Er zijn nog geen producten geïmporteerd.</p>
        {% else %}
            <section>
                {% for product in products %}
                    <article>
                        {% if product.thumbnail %}
                            <img
                                src="{{ product.thumbnail }}"
                                alt="{{ product.title }}"
                                width="200"
                            >
                        {% endif %}

                        <div>
                            <span>{{ product.category }}</span>

                            <h2>{{ product.title }}</h2>

                            <p>{{ product.brand ?? 'Onbekend merk' }}</p>

                            <div>
                                <span>
                                    €{{ product.price|number_format(2, ',', '.') }}
                                </span>

                                <span>
                                    {{ product.discount_percentage|number_format(2, ',', '.') }}% korting
                                </span>

                                <strong>
                                    €{{ product.discount_price|number_format(2, ',', '.') }}
                                </strong>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </section>
        {% endif %}
    </main>
</body>
</html>